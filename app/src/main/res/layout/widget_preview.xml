<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows: the widget with sample events (Android 12+). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    tools:ignore="HardcodedText,ContentDescription">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_weekday"
                android:textColor="@color/widget_preview_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_date"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_add"
            android:padding="10dp"
            android:src="@drawable/ic_widget_add"
            android:tint="@color/widget_preview_on_primary" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="3dp"
        android:text="@string/today"
        android:textColor="@color/widget_preview_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_preview_event"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">
        <!-- RemoteViews only inflate a few view classes: a FrameLayout, not a plain View. -->
        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_event_1"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00–11:00"
                android:textColor="@color/widget_preview_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="3dp"
        android:text="@string/tomorrow"
        android:textColor="@color/widget_preview_on_surface_variant"
        android:textSize="13sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_preview_event"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">
        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar_2" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_event_2"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:30–20:00"
                android:textColor="@color/widget_preview_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
